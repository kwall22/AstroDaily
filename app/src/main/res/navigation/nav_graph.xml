<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/astroGridFragment">

    <fragment
        android:id="@+id/astroGridFragment"
        android:name="com.example.project3.AstroGridFragment"
        android:label="AstroGridFragment"
        tools:layout="@layout/fragment_astro_grid" >
        <action
            android:id="@+id/show_astro_detail"
            app:destination="@id/astroDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/astroDetailFragment"
        android:name="com.example.project3.AstroDetailFragment"
        android:label="AstroDetailFragment"
        tools:layout="@layout/fragment_astro_detail" >
        <argument
            android:name="title"
            app:argType="string" />
        <argument
            android:name="description"
            app:argType="string" />
        <argument
            android:name="url"
            app:argType="string" />
        <argument
            android:name="mediaType"
            app:argType="string" />
        <argument
            android:name="date"
            app:argType="string" />
    </fragment>
</navigation>